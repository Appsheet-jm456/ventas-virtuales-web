# Copia estas variables al panel de tu hosting (o a un .env.local para
# desarrollo). Sin BASEROW_API_TOKEN y BASEROW_TABLE_ID la app arranca pero
# el catálogo se muestra en modo demo.

# Clave del panel de administración (/admin). Elige una larga y única.
ADMIN_PASSWORD=

# Token de la API de Baserow. Necesita permisos de Create/Update/Delete
# sobre la tabla para que el panel de administración pueda guardar cambios.
BASEROW_API_TOKEN=

# ID numérico de la tabla de Baserow con el inventario.
BASEROW_TABLE_ID=

# Solo si usas una instancia autoalojada de Baserow.
# BASEROW_API_URL=https://api.baserow.io
